{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "bim-intermediate/1"
    },
    "units": {
      "type": "string",
      "const": "mm"
    },
    "coordinateSystem": {
      "type": "string",
      "const": "right-handed-z-up"
    },
    "storeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "elevationMm": {
            "type": "number"
          },
          "heightMm": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "elevationMm",
          "heightMm"
        ],
        "additionalProperties": false
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "wall",
              "column",
              "beam",
              "slab",
              "opening",
              "space",
              "stair",
              "balcony",
              "other"
            ]
          },
          "storeyId": {
            "type": "string",
            "minLength": 1
          },
          "hostElementId": {
            "type": "string",
            "minLength": 1
          },
          "geometry": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "outer": {
                    "minItems": 3,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "holes": {
                    "type": "array",
                    "items": {
                      "minItems": 3,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "extrudedPolygon"
                  },
                  "zMm": {
                    "type": "number"
                  },
                  "heightMm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "outer",
                  "holes",
                  "type",
                  "zMm",
                  "heightMm"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "elementIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "origin": {
                "type": "string",
                "enum": [
                  "plan",
                  "user",
                  "estimate"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "elementIds",
              "origin"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "estimated",
              "unresolved"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "storeyId",
          "geometry",
          "source",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "elementId": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "units",
    "coordinateSystem",
    "storeys",
    "elements",
    "issues"
  ],
  "additionalProperties": false
}
